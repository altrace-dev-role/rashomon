{
  "description": "rashomon recorder -- eight entries: declarations, executions, the liveness probe, the turn-end recap on Stop and StopFailure, and its catch-up on UserPromptSubmit for a turn a refused permission prompt interrupted (no matcher on the last three: Claude Code documents none for them). Exec form (args, no shell): the command is the executable itself and Claude Code spawns it directly, which is what lets ${CLAUDE_PLUGIN_ROOT} sit inside a path with a space or a quote and still run.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rashomon",
            "args": ["hook"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rashomon",
            "args": ["post"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rashomon",
            "args": ["post"],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rashomon",
            "args": ["probe", "start"],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rashomon",
            "args": ["probe", "end"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rashomon",
            "args": ["recap"],
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rashomon",
            "args": ["recap"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rashomon",
            "args": ["recap", "pending"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
