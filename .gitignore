bin/
dist/
*.exe
*.test
*.out
coverage.out
coverage.html

# The binary `go build ./cmd/rashomon` drops in the repository root. The module
# IS the repository root, so the output lands beside go.mod as a ten-megabyte
# file named exactly `rashomon` -- and the README tells a contributor to run
# that command, then `./rashomon watch`, because watch has to be run from a
# built binary. `*.exe` already covered the Windows spelling; this covers the
# one everyone else gets. Anchored, so it cannot swallow a source path.
/rashomon

.DS_Store
.idea/
.vscode/

# plugin/bin/ holds the plugin's launchers, plugin/bin/rashomon and
# plugin/bin/pgraph, which are source, and the per-platform binaries
# scripts/build-plugin.sh writes beside them, which are build artefacts of
# several megabytes each. The directory is re-included so the launchers are
# tracked, and the binaries are excluded by name -- the negation alone
# re-included them too, so a built recorder showed up as committable.
!/plugin/bin/
!/plugin/bin/.gitkeep
/plugin/bin/rashomon-*
/plugin/bin/pgraph-*

# .claude/ itself is NOT ignored: this repository tracks its own project
# settings and skills. Only the per-machine file is ignored.
.claude/settings.local.json
