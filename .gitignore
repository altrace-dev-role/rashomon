bin/
dist/
*.exe
*.test
*.out
coverage.out
coverage.html

# The binary `go build ./cmd/rashomon` drops in the repository root. The module
# IS the repository root, so the output lands beside go.mod as a ten-megabyte
# file named exactly `rashomon` -- and the README tells a contributor to run
# that command, then `./rashomon watch`, because watch has to be run from a
# built binary. `*.exe` already covered the Windows spelling; this covers the
# one everyone else gets. Anchored, so it cannot swallow a source path.
/rashomon

.DS_Store
.idea/
.vscode/

# plugin/bin/ holds the plugin's launcher, plugin/bin/rashomon, which is
# source, and the per-platform recorders scripts/build-plugin.sh writes beside
# it, which are build artefacts at eleven megabytes each. The directory is
# re-included so the launcher is tracked, and the recorders are excluded by
# name -- the negation alone re-included them too, so a built recorder showed
# up as committable.
!/plugin/bin/
!/plugin/bin/.gitkeep
/plugin/bin/rashomon-*

# .claude/ itself is NOT ignored: this repository tracks its own project
# settings and skills. Only the per-machine file is ignored.
.claude/settings.local.json
