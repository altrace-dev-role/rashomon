# T1 pins (PLAN.md section 7; frozen by the pre-registration commit, never edited after a run).
# The scratch tree every arm edits, and the arm R binary's source: origin/main after PR #281.
T1_TREE_SHA=5f851724babce82d192e3917cd43ffcad123e9ae
T1_R_BIN_SHA=5f851724babce82d192e3917cd43ffcad123e9ae
# The arm G binary: the autosteer/contracts-v2 head that closes W-M1.9; filled before the first G run.
T1_G_BIN_SHA=
# The judge's pgraph binary is built from T1_TREE_SHA's pgraph module (pgraph is identical on main and the branch).
T1_G_PGRAPH_SHA=
T1_PGRAPH_SHA=5f851724babce82d192e3917cd43ffcad123e9ae
# The pinned tree's own pgraph.log (pgraph sync at T1_TREE_SHA, 17236 rows): A2 counts new symbols against it.
T1_BASELINE_LOG_SHA256=da436b5797596fc7491ecb7b54edacec7f5421a28dd85c9853759c43f542852d
# Session caps (section 7.3; ruling 12). The budget is the per-run hard cap; the n=10 gate is a 2.50 USD mean at n=3.
T1_MODEL=sonnet
T1_MAX_TURNS=80
T1_BUDGET_USD=10
T1_N3_MEAN_CEILING_USD=2.50
T1_ALLOWED_TOOLS="Read,Grep,Glob,Edit,Write,LS,Bash"
# Knowledge for arm G: imported at pinned digests from the owner's ledger and notes (outside git; digests pinned
# here before the first G run so the import is reproducible).
T1_KNOWLEDGE_LEDGER_SHA256=
T1_KNOWLEDGE_NOTES_SHA256=
